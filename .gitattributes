# 统一换行符：仓库内一律存 LF，避免 Windows/macOS 之间产生无意义的整文件 diff
* text=auto eol=lf

# 二进制文件禁止任何换行符转换（尤其是打包好的 EXE）
*.exe binary
*.dll binary
*.pyd binary
*.mp3 binary
*.png binary
*.jpg binary
*.ico binary
*.zip binary

# 这些文件按文本处理并固定 LF
*.py text eol=lf
*.mjs text eol=lf
*.html text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.spec text eol=lf
*.json text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
